rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Rules for users collection
    match /users/{userId} {
      // Allow users to read/write their own profiles; allow admin to read all
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.email == 'vigneshbs7653@gmail.com');
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Rules for contact_messages collection
    match /contact_messages/{messageId} {
      // Allow anyone (including guests) to send messages
      allow create: if true;
      // Allow only the admin to view or manage messages
      allow read, update, delete: if request.auth != null && request.auth.token.email == 'vigneshbs7653@gmail.com';
    }
  }
}
